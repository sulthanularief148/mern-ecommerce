NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://ecofashion:ecofashion_pw@localhost:3306/ecofashion"
REDIS_URL="redis://localhost:6379"

CLOUDINARY_API_KEY=""
CLOUDINARY_SECRET_KEY=""
CLOUDINARY_NAME=""

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

ADMIN_EMAIL=""
ADMIN_PASSWORD=""

STRIPE_API_KEY=""
STRIPE_PUBLIC_KEY=""
# From the Stripe dashboard's webhook endpoint config (or `stripe listen` in
# dev). Optional — without it, payment confirmation still works via the
# authenticated /verify/stripe poll on redirect, just without the
# closed-tab-safety-net the webhook provides.
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_API_KEY=""
RAZORPAY_API_SECRET=""

ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8080"

# Base URL of the storefront — used to build links inside emails (e.g. the
# password reset link). Point this at your real domain in production.
CLIENT_URL="http://localhost:5173"

# Optional. Without these, password-reset emails are logged to the server
# console instead of sent — useful for local dev, but set these for real
# delivery in production (works with Gmail app passwords, SendGrid SMTP,
# AWS SES SMTP, Mailtrap, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Webfarm's Wear <no-reply@webfarmswear.com>"

MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE="ecofashion"
MYSQL_USER="ecofashion"
MYSQL_PASSWORD=""

# Optional — error tracking stays off entirely until this is set. Get one at
# sentry.io (free tier available).
SENTRY_DSN=""
